# Copy to .env (gitignored). The Makefile exports these.
DATABASE_URL=postgresql://causetrace:causetrace@localhost:5432/causetrace
# The test suite drops and recreates tables here; never point it at a database you care about.
TEST_DATABASE_URL=postgresql://causetrace:causetrace@localhost:5432/causetrace_test
# Retrieval model revisions are pinned in src/causetrace/config.py; override only deliberately.
# LLM calls (causetrace.llm): key, per-process spend limit in USD, model override.
ANTHROPIC_API_KEY=
MAX_USD=10
# CAUSETRACE_LLM_MODEL=claude-haiku-5-5
